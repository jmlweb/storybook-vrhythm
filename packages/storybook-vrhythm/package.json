{
  "name": "storybook-vrhythm",
  "version": "0.3.0",
  "description": "Baseline grid overlay for Storybook — see your vertical rhythm while you build",
  "license": "MIT",
  "author": "jmlweb",
  "homepage": "https://github.com/jmlweb/storybook-vrhythm",
  "repository": {
    "type": "git",
    "url": "https://github.com/jmlweb/storybook-vrhythm.git"
  },
  "keywords": [
    "storybook-addon",
    "storybook",
    "vertical-rhythm",
    "baseline-grid",
    "typography",
    "layout",
    "design-system",
    "css-grid",
    "decorator",
    "debug",
    "spacing",
    "material-design",
    "tailwind"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "import": "./dist/preview.js",
      "default": "./dist/preview.js"
    },
    "./preset": {
      "import": "./dist/preset.js",
      "default": "./dist/preset.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "preset.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "storybook": "^10.0.0 || ^11.0.0"
  },
  "storybook": {
    "displayName": "Vertical Rhythm Grid",
    "supportedFrameworks": [
      "react",
      "vue",
      "angular",
      "web-components",
      "html-vite",
      "svelte"
    ]
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'test/**/*.ts'"
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.2",
    "jsdom": "^29.0.1",
    "prettier": "^3.5.3",
    "storybook": "^10.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  }
}
