{
  "name": "storybook-vrhythm",
  "version": "0.5.0",
  "description": "Baseline grid overlay for Storybook — see your vertical rhythm while you build",
  "license": "MIT",
  "author": "jmlweb",
  "homepage": "https://github.com/jmlweb/storybook-vrhythm",
  "repository": {
    "type": "git",
    "url": "https://github.com/jmlweb/storybook-vrhythm.git"
  },
  "keywords": [
    "storybook-addon",
    "storybook",
    "vertical-rhythm",
    "baseline-grid",
    "typography",
    "layout",
    "design-system",
    "css-grid",
    "decorator",
    "debug",
    "spacing",
    "material-design",
    "tailwind"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "import": "./dist/preview.js",
      "default": "./dist/preview.js"
    },
    "./audit": {
      "types": "./dist/audit.d.ts",
      "import": "./dist/audit.js",
      "default": "./dist/audit.js"
    },
    "./preset": {
      "import": "./dist/preset.js",
      "default": "./dist/preset.js"
    },
    "./llms.txt": "./llms.txt",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "preset.js",
    "llms.txt"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "storybook": "^10.0.0"
  },
  "storybook": {
    "displayName": "Vertical Rhythm Grid",
    "icon": "https://raw.githubusercontent.com/jmlweb/storybook-vrhythm/master/packages/storybook-vrhythm/icon.png",
    "supportedFrameworks": [
      "react",
      "vue",
      "angular",
      "web-components",
      "html",
      "svelte"
    ]
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'test/**/*.ts'"
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "storybook": "^10.6.5",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
