{
  "name": "storybook-vrhythm",
  "version": "1.0.0-next.2",
  "description": "Baseline grid for Storybook that coding agents can run: a measured audit with exact pixel deltas, plus a visual overlay",
  "license": "MIT",
  "author": "jmlweb",
  "homepage": "https://github.com/jmlweb/storybook-vrhythm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmlweb/storybook-vrhythm.git",
    "directory": "packages/storybook-vrhythm"
  },
  "bugs": "https://github.com/jmlweb/storybook-vrhythm/issues",
  "keywords": [
    "storybook-addon",
    "storybook",
    "vertical-rhythm",
    "baseline-grid",
    "typography",
    "layout",
    "design-system",
    "css-grid",
    "decorator",
    "debug",
    "spacing",
    "material-design",
    "tailwind",
    "bootstrap",
    "carbon",
    "testing",
    "visual-testing",
    "ai",
    "ai-agents",
    "coding-agents",
    "agent-skills",
    "mcp",
    "llms-txt"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "default": "./dist/preview.js"
    },
    "./audit": {
      "types": "./dist/audit.d.ts",
      "default": "./dist/audit.js"
    },
    "./preset": "./dist/preset.js",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "llms.txt",
    "skills"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "peerDependencies": {
    "storybook": "^10.0.0 || ^11.0.0-0"
  },
  "storybook": {
    "displayName": "Vertical Rhythm Grid",
    "icon": "https://raw.githubusercontent.com/jmlweb/storybook-vrhythm/main/packages/storybook-vrhythm/icon.png",
    "supportedFrameworks": [
      "react",
      "vue",
      "angular",
      "web-components",
      "html",
      "svelte"
    ]
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^30.1.3",
    "publint": "0.3.25",
    "storybook": ">=11.0.0-0 <12.0.0-0",
    "tsdown": "^0.23.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
